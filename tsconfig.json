{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "types": [
      "react",
      "react-dom",
      "node"
    ]
  },
  "include": [
    "apps/api/src",
    "apps/web/src",
    "apps/worker/src",
    "packages/*/src",
    "tests",
    "scripts"
  ]
}